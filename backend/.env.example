# Copy this file to .env and populate the values for your hosting environment.
NODE_ENV=production
PORT=5001
HOST=0.0.0.0
SESSION_SECRET=replace-with-a-long-random-secret
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=https://mahasu.co.in
FRONTEND_URLS=https://mahasu.co.in,https://www.mahasu.co.in
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your-db-password
DB_NAME=mahasu_ecommerce
DB_PORT=3306
DB_CONNECTION_LIMIT=10
DB_CONNECT_TIMEOUT=60000
DB_ACQUIRE_TIMEOUT=60000
DB_TIMEOUT=60000
DB_SSL=false
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-secret
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-email-password
EMAIL_FROM=noreply@your-domain.com
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://your-domain.com/api/auth/google/callback
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_CALLBACK_URL=https://your-domain.com/api/auth/facebook/callback
LOG_LEVEL=info
