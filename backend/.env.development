# Backend Development Environment Variables
# This file is for LOCAL DEVELOPMENT ONLY - Do NOT commit sensitive values to version control

# ====================
# Server Configuration
# ====================
NODE_ENV=development
PORT=5000

# ====================
# Database Configuration
# ====================
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=root
DB_NAME=mahasu_ecommerce
DB_PORT=3306

# ====================
# JWT & Session Security
# ====================
# Safe values for development - change these before production!
JWT_SECRET=dev-super-secret-jwt-key-change-in-production-min-32-characters
SESSION_SECRET=dev-super-secret-session-key-change-in-production-32-chars

# ====================
# Google OAuth Configuration
# ====================
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ====================
# Facebook OAuth Configuration
# ====================
FACEBOOK_CLIENT_ID=your_facebook_client_id
FACEBOOK_CLIENT_SECRET=your_facebook_client_secret
FACEBOOK_CALLBACK_URL=http://localhost:5000/api/auth/facebook/callback

# ====================
# Payment Gateway (Razorpay)
# ====================
RAZORPAY_KEY_ID=rzp_test_your_test_key_id
RAZORPAY_KEY_SECRET=your_test_secret

# ====================
# Email Configuration (Nodemailer)
# ====================
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_specific_password
EMAIL_FROM=dev@mahasu.com

# ====================
# Frontend URL
# ====================
FRONTEND_URL=http://localhost:5173

# ====================
# Logging
# ====================
LOG_LEVEL=debug
LOG_FILE=logs/app.log
