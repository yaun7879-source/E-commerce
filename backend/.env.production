# Production Environment Variables
# ⚠️ CRITICAL: All values marked with [CHANGE] must be replaced with actual values
# ⚠️ NEVER commit this file to version control!

# ====================
# Server Configuration
# ====================
NODE_ENV=production
PORT=5001

# ====================
# Database Configuration
# ====================
DB_HOST=[CHANGE - Your database host or localhost if local]
DB_USER=[CHANGE - Database username]
DB_PASSWORD=[CHANGE - Strong database password]
DB_NAME=mahasu_ecommerce
DB_PORT=3306
DB_CONNECTION_LIMIT=10

# ====================
# JWT & Session Security (CRITICAL - GENERATE STRONG RANDOM VALUES)
# ====================
# Generate using: openssl rand -base64 32
JWT_SECRET=[CHANGE - Min 32 chars, generate with: openssl rand -base64 32]
SESSION_SECRET=[CHANGE - Min 32 chars, generate with: openssl rand -base64 32]

# ====================
# Frontend URL (for CORS)
# ====================
FRONTEND_URL=[CHANGE - Your production domain, e.g., https://mahasu.com]

# ====================
# Google OAuth 2.0 Configuration
# ====================
# Get from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=[CHANGE - From Google Cloud Console]
GOOGLE_CLIENT_SECRET=[CHANGE - From Google Cloud Console]
GOOGLE_CALLBACK_URL=[CHANGE - e.g., https://yourdomain.com/api/auth/google/callback]

# ====================
# Facebook OAuth Configuration
# ====================
# Get from: https://developers.facebook.com/
FACEBOOK_CLIENT_ID=[CHANGE - From Facebook Developer Console]
FACEBOOK_CLIENT_SECRET=[CHANGE - From Facebook Developer Console]
FACEBOOK_CALLBACK_URL=[CHANGE - e.g., https://yourdomain.com/api/auth/facebook/callback]

# ====================
# Payment Gateway (Razorpay)
# ====================
# Get from: https://dashboard.razorpay.com/app/settings/api-keys
RAZORPAY_KEY_ID=[CHANGE - Live Key ID from Razorpay]
RAZORPAY_KEY_SECRET=[CHANGE - Live Key Secret from Razorpay]

# ====================
# Email Configuration (Nodemailer)
# ====================
EMAIL_SERVICE=gmail
EMAIL_USER=[CHANGE - Your Gmail address]
EMAIL_PASSWORD=[CHANGE - Gmail app-specific password]
EMAIL_FROM=noreply@[yourdomain.com]

# ====================
# Monitoring & Logging
# ====================
LOG_LEVEL=info
LOG_FILE=/var/log/mahasu/app.log
SENTRY_DSN=[OPTIONAL - Error tracking URL from Sentry.io]

# ====================
# Application Settings
# ====================
MAX_REQUEST_SIZE=10mb
SESSION_TIMEOUT=86400000
